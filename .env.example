# ── LLM Backend ──────────────────────────────────────────────────────────────
# We use litellm which supports 100+ models. Format: provider/model_name
# Examples: 
#   groq/llama-3.3-70b-versatile
#   openai/gpt-4o
#   anthropic/claude-3-5-sonnet-20241022
#   gemini/gemini-1.5-pro
#   ollama/llama3.2
LITELLM_MODEL=groq/llama-3.3-70b-versatile

# Provide the API keys for the providers you want to use
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key

# Ollama API URL (if using ollama/...)
OLLAMA_BASE_URL=http://localhost:11434

# ── Embedding Model ──────────────────────────────────────────────────────────
# sentence-transformers model name — downloaded on first run (~80 MB)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ── Vector Store (ChromaDB) ───────────────────────────────────────────────────
# Relative path from the project root — ChromaDB will create this directory.
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=5          # dense retrieval top-k
BM25_TOP_K=10    # BM25 candidate pool size
RERANK_TOP_N=3   # final chunks after reranking

# ── Generation ────────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0     # 0 = deterministic (best for factual RAG)
MAX_TOKENS=1024
