# ── LLM Backend ──────────────────────────────────────────────────────────────
# Get a free Groq API key at https://console.groq.com (no credit card needed)
GROQ_API_KEY=gsk_your_key_here

# Which LLM backend to use: "groq" (default) or "ollama" (fully local)
LLM_BACKEND=groq

# Groq model — check https://console.groq.com/docs/models for current free-tier list
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama model name — run `ollama pull llama3.2` to download locally
OLLAMA_MODEL=llama3.2

# ── Embedding Model ──────────────────────────────────────────────────────────
# sentence-transformers model name — downloaded on first run (~80 MB)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ── Vector Store (ChromaDB) ───────────────────────────────────────────────────
# Relative path from the project root — ChromaDB will create this directory.
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=5          # dense retrieval top-k
BM25_TOP_K=10    # BM25 candidate pool size
RERANK_TOP_N=3   # final chunks after reranking

# ── Generation ────────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0     # 0 = deterministic (best for factual RAG)
MAX_TOKENS=1024
