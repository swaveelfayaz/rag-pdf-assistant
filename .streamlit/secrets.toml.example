# .streamlit/secrets.toml.example
# ─────────────────────────────────────────────────────────────────────────────
# COPY THIS FILE'S CONTENTS into the Streamlit Cloud Secrets Manager.
# (App dashboard → Settings → Secrets → paste below)
#
# DO NOT rename this file to secrets.toml and commit it.
# The real secrets.toml is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

GROQ_API_KEY = "gsk_your_key_here"

# Optional overrides (these already have sensible defaults in utils/config.py):
# GROQ_MODEL            = "llama-3.3-70b-versatile"
# CHROMA_PERSIST_DIR    = "./chroma_db"
# CHROMA_COLLECTION_NAME = "rag_documents"
# TOP_K                 = "5"
# CHUNK_SIZE            = "800"
# CHUNK_OVERLAP         = "150"
